[Unit]
Description=UPS helper observe-only controller
After=network.target nut-server.service
# No Requires/BindsTo: an unavailable NUT server must not stop the controller.

[Service]
Type=simple
DynamicUser=yes
StateDirectory=ups-helper
StateDirectoryMode=0700
ExecStart=/opt/ups-helper/.venv/bin/ups-helper monitor --config /etc/ups-helper/config.yaml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
StandardOutput=journal
StandardError=journal
# Stopping this process never shuts down the Pi or any attached machine.

[Install]
WantedBy=multi-user.target
